APP_NAME="Enterprise Procurement Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production target is MySQL 8. Switch DB_CONNECTION to sqlite for a
# zero-config local sandbox (see Installation Guide, docs/INSTALLATION.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pms_procurement
DB_USERNAME=pms_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@agency.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# AWS S3 - Document Management (private bucket, versioned, encrypted)
# ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=pms-procurement-documents
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SSE=AES256

# Driver used by the logical "documents" disk. Use "local" for development
# (files land in storage/app/documents) and "s3" in staging/production.
DOCUMENTS_DISK_DRIVER=local
DOCUMENT_SIGNED_URL_MINUTES=15

# ---------------------------------------------------------------------
# PhilGEPS (manual posting fallback when the live API is unavailable)
# ---------------------------------------------------------------------
PHILGEPS_API_BASE_URL=
PHILGEPS_API_KEY=
PHILGEPS_MANUAL_MODE=true

# ---------------------------------------------------------------------
# SMS Gateway (optional, used for BAC/bidding notifications)
# ---------------------------------------------------------------------
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=PMS-GOV

# ---------------------------------------------------------------------
# Security / password policy defaults (overridable in Settings > Security)
# ---------------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=120
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRY_DAYS=90

VITE_APP_NAME="${APP_NAME}"
